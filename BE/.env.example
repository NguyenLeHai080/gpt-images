POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mintforge_db

# Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
