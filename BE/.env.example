# MintForge Backend Environment Configuration

# Security
SECRET_KEY=mintforge-super-secret-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database (pgsql)
POSTGRES_USER=mintforge_user
