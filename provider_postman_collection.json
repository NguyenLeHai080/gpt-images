  "item": [
    {
      "name": "1. Test Trực Tiếp NCC - Tạo Ảnh từ Chữ (Text-to-Image)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{upstream_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"A cute little kitten playing with a ball in a sunlit living room, 8k cinematic photorealistic\",\n  \"model\": \"gpt-image-2\",\n  \"modelKey\": \"gpt-image-2\",\n  \"mode\": \"generation\",\n  \"aspectRatio\": \"1024x1024\",\n  \"resolution\": \"1k\",\n  \"quality\": \"medium\",\n  \"count\": 1\n}"
        },
        "url": {
          "raw": "{{upstream_url}}/v1/images/generations",
          "host": [
            "{{upstream_url}}"
          ],
          "path": [
            "v1",
            "images",
            "generations"
          ]
        },
        "description": "Gửi yêu cầu tạo ảnh từ chữ trực tiếp lên cụm GPU của Nhà Cung Cấp."
      },
      "response": []
    },
    {
